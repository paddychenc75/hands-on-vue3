{
  "name": "hands-on-vue3",
  "version": "19.0.0",
  "private": true,
  "description": "动手学 Vue 3：互动课程，每章有讲解、实验台、练习和自测（VitePress）",
  "scripts": {
    "dev": "vitepress dev course",
    "build": "vitepress build course",
    "preview": "vitepress preview course",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "test:unit": "vitest run",
    "check": "npm run typecheck && npm run check:content && npm run test:unit",
    "test:e2e": "node scripts/e2e.mjs",
    "test:site": "npm run build && npm run test:e2e",
    "test": "npm run check && npm run build && npm run test:e2e",
    "new-chapter": "node scripts/new-chapter.mjs",
    "screenshots": "node scripts/shot.mjs",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-vue": "0.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "markdown-it-container": "4.0.0",
    "markdown-it-deflist": "4.0.0",
    "playwright": "1.56.1",
    "typescript": "7.0.2",
    "vitepress": "1.6.4",
    "vitest": "5.0.3",
    "vue": "3.5.43"
  }
}
